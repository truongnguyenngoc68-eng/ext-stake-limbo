{
  "manifest_version": 3,
  "name": "Limbo Restart",
  "version": "1.5.7",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.telegram.org/*",
    "https://stake1022.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Mở Limbo Auto"
  },
  "description": "Chạy lại Auto Limbo sau khi hoàn thành, đưa tiền cược về mức cố định khi cần.",
  "content_scripts": [
    {
      "matches": [
        "https://stake1022.com/*"
      ],
      "js": [
        "bet-observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://stake1022.com/*"
      ],
      "js": [
        "debug-log.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
